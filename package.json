{
  "name": "onda-ticketing",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "db:start": "./scripts/dev-db.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "retention:purge": "tsx scripts/retention-purge.ts",
    "reservations:expire": "tsx scripts/expire-reservations.ts",
    "test": "node scripts/ensure-test-env.mjs && dotenv -e .env.test -- sh -c 'prisma migrate deploy >/dev/null && vitest run'",
    "tickets:sample": "tsx scripts/render-sample-tickets.ts",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "mail:test": "dotenv -e .env -- tsx scripts/mail-test.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "create-leader": "tsx scripts/create-leader.ts",
    "setup-email": "node scripts/setup-email.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "jsqr": "^1.4.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.1.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
