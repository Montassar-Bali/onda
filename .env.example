# Copy to .env (never commit .env). Generate every secret with:  openssl rand -base64 32
# In production the server refuses to start if any of these is missing, weak or reused.

# PostgreSQL — single source of truth for Admin, Team and Customer interfaces
DATABASE_URL="postgresql://tropical@localhost:5433/tropical"
# Direct (unpooled) connection for migrations. Locally the same as DATABASE_URL.
# On Vercel Postgres (Neon) both variables are created for you when you connect the database to the project.
DATABASE_URL_UNPOOLED="postgresql://tropical@localhost:5433/tropical"
# Signs session cookies (>= 32 random characters)
SESSION_SECRET=""
# CIN encryption key: AES-256-GCM, base64 of 32 bytes. Losing it makes stored CINs unreadable.
CIN_ENC_KEY=""
CIN_ENC_KEY_VERSION="1"
# CIN lookup key: HMAC-SHA256, base64 of 32 bytes. Must differ from CIN_ENC_KEY.
CIN_HMAC_KEY=""
# Days after an identity's last event before its CIN is crypto-shredded
CIN_RETENTION_DAYS="365"
# Public base URL (https:// in production) — used in ticket emails
APP_URL="http://localhost:3000"
# Number of reverse proxies in front of the app that append to X-Forwarded-For (usually 1 in production).
# Leave 0 when the app is reached directly: the header is then ignored because clients can forge it.
TRUST_PROXY_HOPS="0"
# On Vercel this is not needed: the client IP is read from Vercel's own x-real-ip header automatically.

# Vercel Cron: a long random string. Vercel sends it to /api/cron/* so nobody else can trigger those jobs.
CRON_SECRET=""
# Email delivery — tickets are sent to the buyer and each attendee by email. REQUIRED in production.
# Any SMTP service works. Put the credentials only here, never in code. Examples (URL-encode @ as %40):
#   Brevo:   smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
#   Resend:  smtps://resend:API_KEY@smtp.resend.com:465
#   Gmail:   smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465   (needs 2-step verification + an App Password)
# Left empty in development, each email is saved as a .eml file in ./.mail-outbox instead (open it in Mail).
SMTP_URL=""
# Sender shown to customers. With Gmail it must be your Gmail address; with Brevo/Resend, a verified sender/domain.
MAIL_FROM="ONDA Tickets <tickets@example.com>"

# Development only — passwords for the demo accounts created by `npm run db:seed`.
# Leave empty to have random ones generated and printed once.
SEED_LEADER_PASSWORD=""
SEED_SELLER_PASSWORD=""
