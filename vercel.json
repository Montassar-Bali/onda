{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/expire-reservations",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 4 * * *"
    }
  ],
  "regions": [
    "fra1"
  ]
}
