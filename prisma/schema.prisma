// Tropical Event Management & Ticketing — schema v2.0
//
// Core principle: every ticket, every sale, every dinar and every entry has an
// identifiable history. Money is stored as integer MILLIMES (1 TND = 1000 millimes).
//
// Ticket state is split into independent dimensions (never one status field):
//   A. inventory  (TicketInventoryStatus)
//   B. issuance   (Ticket.kind / issuedBy / batch)
//   C. payment    (PaymentCollectionStatus + cash_transactions)
//   D. admission  (TicketAdmissionStatus)
//   E. reservations (separate tables, ReservationStatus)
//   F. cash reconciliation (seller_cash_accounts, cash_handovers, cash_reconciliations, cash_discrepancies)
//
// Additional CHECK constraints, append-only triggers and partial unique indexes live in
// prisma/migrations/*_v2_constraints/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & authorization ─────────────────────────────

enum Role {
  TEAM_LEADER // administrator: creates events, batches, reconciles cash
  TEAM_MEMBER // seller / scanner
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  salesPoints          SalesPointMember[]
  eventAssignments     EventSeller[]
  eventsCreated        Event[]                    @relation("EventCreatedBy")
  ticketsSold          Ticket[]                   @relation("TicketSoldBy")
  ticketsIssued        Ticket[]                   @relation("TicketIssuedBy")
  ticketsAssigned      Ticket[]                   @relation("TicketAssignedSeller")
  ticketsCheckedIn     Ticket[]                   @relation("TicketCheckedInBy")
  cashTransactions     CashTransaction[]          @relation("CashSeller")
  cashReported         CashTransaction[]          @relation("CashReportedBy")
  cashAuthorized       CashTransaction[]          @relation("CashAuthorizedBy")
  cashAccounts         SellerCashAccount[]
  handovers            CashHandover[]             @relation("HandoverSeller")
  reconciliations      CashReconciliation[]       @relation("ReconciledBy")
  discrepanciesHandled CashDiscrepancy[]          @relation("DiscrepancyResolvedBy")
  batchesCreated       PhysicalTicketBatch[]      @relation("BatchCreatedBy")
  batchesPrinted       PhysicalTicketBatch[]      @relation("BatchPrintedBy")
  assignmentsMade      PhysicalTicketAssignment[] @relation("AssignmentBy")
  assignmentsReceived  PhysicalTicketAssignment[] @relation("AssignmentSeller")
  transfersAuthorized  TicketTransfer[]           @relation("TransferAuthorizedBy")
  transfersFrom        TicketTransfer[]           @relation("TransferFromSeller")
  transfersTo          TicketTransfer[]           @relation("TransferToSeller")
  movements            TicketInventoryMovement[]
  identityAccesses     IdentityAccessLog[]
  auditLogs            AuditLog[]
  scanLogs             ScanLog[]
  sessions             Session[]
  reservationAdmits    ReservationAttendee[]      @relation("ReservationAdmittedBy")
  reservationsHandled  Reservation[]              @relation("ReservationHandledBy")

  @@map("users")
}

/// Server-side login sessions. The cookie only carries a signed session id; every request checks
/// the row, so signing out or deactivating a user revokes access immediately.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model SalesPoint {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  members          SalesPointMember[]
  tickets          Ticket[]                   @relation("TicketSalesPoint")
  assignedTickets  Ticket[]                   @relation("TicketAssignedSalesPoint")
  cashTransactions CashTransaction[]
  assignments      PhysicalTicketAssignment[]
  transfersFrom    TicketTransfer[]           @relation("TransferFromSalesPoint")
  transfersTo      TicketTransfer[]           @relation("TransferToSalesPoint")

  @@map("sales_points")
}

model SalesPointMember {
  userId       String     @map("user_id") @db.Uuid
  salesPointId String     @map("sales_point_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id])
  salesPoint   SalesPoint @relation(fields: [salesPointId], references: [id])

  @@id([userId, salesPointId])
  @@map("sales_point_members")
}

// ───────────────────────────── Events & categories ─────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String?
  /// Optional theme / tagline printed on tickets, e.g. "Nuit Bleue — Électro & Malouf".
  theme       String?
  /// Optional colour of this edition's theme (#rrggbb). Tints the poster and ticket artwork; the site itself stays ONDA red.
  themeColor  String?     @map("theme_color")
  venue       String
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  status      EventStatus @default(DRAFT)
  publishedAt DateTime?   @map("published_at")
  createdById String      @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  /// Hard admission limit. Never exceeded (enforced by conditional UPDATE + CHECK).
  venueCapacity           Int @map("venue_capacity")
  /// Paid-ticket inventory (digital + physical activations combined).
  paidTicketCapacity      Int @map("paid_ticket_capacity")
  complimentaryAllocation Int @default(0) @map("complimentary_allocation")
  maxTicketsPerIdentity   Int @default(4) @map("max_tickets_per_identity")

  /// Atomic counters (updated only inside transactions with conditional WHERE clauses).
  paidSoldCount         Int @default(0) @map("paid_sold_count")
  compIssuedCount       Int @default(0) @map("comp_issued_count")
  checkedInCount        Int @default(0) @map("checked_in_count")
  /// Reservation-based admissions are part of checkedInCount; tracked separately for reporting.
  reservationAdmitCount Int @default(0) @map("reservation_admit_count")

  createdBy            User                  @relation("EventCreatedBy", fields: [createdById], references: [id])
  categories           TicketCategory[]
  sellers              EventSeller[]
  tickets              Ticket[]
  batches              PhysicalTicketBatch[]
  cashTransactions     CashTransaction[]
  cashAccounts         SellerCashAccount[]
  reservationInventory ReservationInventory?
  reservations         Reservation[]
  scanLogs             ScanLog[]

  @@map("events")
}

model EventSeller {
  eventId String @map("event_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
  @@map("event_sellers")
}

model TicketCategory {
  id            String  @id @default(uuid()) @db.Uuid
  eventId       String  @map("event_id") @db.Uuid
  name          String
  /// Official price in millimes. Sellers can never override it.
  priceMillimes Int     @map("price_millimes")
  /// Optional per-category cap within the event's paid capacity.
  capacity      Int?
  soldCount     Int     @default(0) @map("sold_count")
  active        Boolean @default(true)

  event        Event                 @relation(fields: [eventId], references: [id])
  tickets      Ticket[]
  batches      PhysicalTicketBatch[]
  reservations Reservation[]

  @@unique([eventId, name])
  @@map("ticket_categories")
}

// ───────────────────────────── Identity (CIN) ─────────────────────────────

/// One row per national ID. CIN is stored only as AES-256-GCM ciphertext plus a keyed
/// HMAC digest for lookup / duplicate detection. Plaintext CIN never touches the DB.
model CustomerIdentityRecord {
  id             String    @id @default(uuid()) @db.Uuid
  fullName       String    @map("full_name")
  phone          String
  email          String
  cinCiphertext  Bytes?    @map("cin_ciphertext")
  cinIv          Bytes?    @map("cin_iv")
  cinTag         Bytes?    @map("cin_tag")
  cinKeyVersion  Int       @map("cin_key_version")
  /// HMAC-SHA256(CIN_HMAC_KEY, normalized CIN). Null after retention purge.
  cinHmac        String?   @unique @map("cin_hmac")
  /// Last 3 digits only, for masked display (e.g. •••••123).
  cinLast3       String?   @map("cin_last3")
  retentionUntil DateTime  @map("retention_until")
  purgedAt       DateTime? @map("purged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  ticketsHeld          Ticket[]              @relation("TicketHolder")
  ticketsPurchased     Ticket[]              @relation("TicketPurchaser")
  cashTransactions     CashTransaction[]
  reservationsMade     Reservation[]
  reservationAttendees ReservationAttendee[]
  accessLogs           IdentityAccessLog[]

  @@map("customer_identity_records")
}

/// Append-only (trigger). Every full-CIN reveal or CIN lookup by an administrator.
model IdentityAccessLog {
  id           String   @id @default(uuid()) @db.Uuid
  identityId   String?  @map("identity_id") @db.Uuid
  accessedById String   @map("accessed_by_id") @db.Uuid
  action       String // REVEAL_FULL_CIN | LOOKUP_BY_CIN
  reason       String
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  identity   CustomerIdentityRecord? @relation(fields: [identityId], references: [id])
  accessedBy User                    @relation(fields: [accessedById], references: [id])

  @@index([identityId])
  @@map("identity_access_logs")
}

// ───────────────────────────── Tickets ─────────────────────────────

enum TicketKind {
  DIGITAL
  PHYSICAL
  COMPLIMENTARY
}

enum TicketInventoryStatus {
  AVAILABLE
  ASSIGNED
  SOLD
  VOID
  RETURNED
}

enum PaymentCollectionStatus {
  NOT_COLLECTED
  CASH_REPORTED_COLLECTED
  CASH_RECONCILED
  REVERSED
}

enum TicketAdmissionStatus {
  NOT_ELIGIBLE
  VALID
  CHECKED_IN
  REVOKED
}

model Ticket {
  id         String     @id @default(uuid()) @db.Uuid
  eventId    String     @map("event_id") @db.Uuid
  categoryId String     @map("category_id") @db.Uuid
  kind       TicketKind
  /// Human-readable serial printed on tickets, e.g. EVT1-B003-0042.
  serial     String     @unique
  /// Opaque 256-bit random token encoded in the QR. Contains no personal data.
  qrToken    String     @unique @map("qr_token")
  /// 12-character code printed under the QR (XXXX-XXXX-XXXX), typed in when a QR will not scan.
  /// Unambiguous alphabet (no 0/O/1/I), ~60 bits of randomness. Rotated on reissue, like the QR token.
  manualCode String     @unique @map("manual_code")

  inventoryStatus TicketInventoryStatus   @map("inventory_status")
  paymentStatus   PaymentCollectionStatus @default(NOT_COLLECTED) @map("payment_status")
  admissionStatus TicketAdmissionStatus   @default(NOT_ELIGIBLE) @map("admission_status")

  /// Official price snapshot at sale (millimes). 0 for complimentary.
  priceMillimes Int? @map("price_millimes")

  holderIdentityId    String? @map("holder_identity_id") @db.Uuid
  purchaserIdentityId String? @map("purchaser_identity_id") @db.Uuid

  // Physical inventory
  batchId              String? @map("batch_id") @db.Uuid
  assignedSellerId     String? @map("assigned_seller_id") @db.Uuid
  assignedSalesPointId String? @map("assigned_sales_point_id") @db.Uuid

  // Sale / activation
  soldById     String?   @map("sold_by_id") @db.Uuid
  soldAt       DateTime? @map("sold_at")
  salesPointId String?   @map("sales_point_id") @db.Uuid

  // Complimentary issuance
  issuedById          String? @map("issued_by_id") @db.Uuid
  complimentaryReason String? @map("complimentary_reason")

  // Admission
  checkedInAt   DateTime? @map("checked_in_at")
  checkedInById String?   @map("checked_in_by_id") @db.Uuid

  reservationAttendeeId String? @unique @map("reservation_attendee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event               Event                      @relation(fields: [eventId], references: [id])
  category            TicketCategory             @relation(fields: [categoryId], references: [id])
  holder              CustomerIdentityRecord?    @relation("TicketHolder", fields: [holderIdentityId], references: [id])
  purchaser           CustomerIdentityRecord?    @relation("TicketPurchaser", fields: [purchaserIdentityId], references: [id])
  batch               PhysicalTicketBatch?       @relation(fields: [batchId], references: [id])
  assignedSeller      User?                      @relation("TicketAssignedSeller", fields: [assignedSellerId], references: [id])
  assignedSalesPoint  SalesPoint?                @relation("TicketAssignedSalesPoint", fields: [assignedSalesPointId], references: [id])
  soldBy              User?                      @relation("TicketSoldBy", fields: [soldById], references: [id])
  salesPoint          SalesPoint?                @relation("TicketSalesPoint", fields: [salesPointId], references: [id])
  issuedBy            User?                      @relation("TicketIssuedBy", fields: [issuedById], references: [id])
  checkedInBy         User?                      @relation("TicketCheckedInBy", fields: [checkedInById], references: [id])
  reservationAttendee ReservationAttendee?       @relation(fields: [reservationAttendeeId], references: [id])
  cashTransactions    CashTransaction[]
  assignments         PhysicalTicketAssignment[]
  transfers           TicketTransfer[]
  movements           TicketInventoryMovement[]
  scanLogs            ScanLog[]

  @@index([eventId, inventoryStatus])
  @@index([eventId, holderIdentityId])
  @@index([assignedSellerId])
  @@map("tickets")
}

model PhysicalTicketBatch {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  number      Int
  /// 1..200 (CHECK constraint).
  quantity    Int
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  printedAt   DateTime? @map("printed_at")
  printedById String?   @map("printed_by_id") @db.Uuid
  printCount  Int       @default(0) @map("print_count")

  event     Event          @relation(fields: [eventId], references: [id])
  category  TicketCategory @relation(fields: [categoryId], references: [id])
  createdBy User           @relation("BatchCreatedBy", fields: [createdById], references: [id])
  printedBy User?          @relation("BatchPrintedBy", fields: [printedById], references: [id])
  tickets   Ticket[]

  @@unique([eventId, number])
  @@map("physical_ticket_batches")
}

/// Assignment history of physical tickets to sellers / sales points. Append-only.
model PhysicalTicketAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  sellerId     String?  @map("seller_id") @db.Uuid
  salesPointId String?  @map("sales_point_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  ticket     Ticket      @relation(fields: [ticketId], references: [id])
  seller     User?       @relation("AssignmentSeller", fields: [sellerId], references: [id])
  salesPoint SalesPoint? @relation(fields: [salesPointId], references: [id])
  assignedBy User        @relation("AssignmentBy", fields: [assignedById], references: [id])

  @@index([ticketId])
  @@map("physical_ticket_assignments")
}

/// Authorized transfer of an assigned physical ticket between sellers / sales points. Append-only.
model TicketTransfer {
  id               String   @id @default(uuid()) @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  fromSellerId     String?  @map("from_seller_id") @db.Uuid
  fromSalesPointId String?  @map("from_sales_point_id") @db.Uuid
  toSellerId       String?  @map("to_seller_id") @db.Uuid
  toSalesPointId   String?  @map("to_sales_point_id") @db.Uuid
  authorizedById   String   @map("authorized_by_id") @db.Uuid
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")

  ticket         Ticket      @relation(fields: [ticketId], references: [id])
  fromSeller     User?       @relation("TransferFromSeller", fields: [fromSellerId], references: [id])
  fromSalesPoint SalesPoint? @relation("TransferFromSalesPoint", fields: [fromSalesPointId], references: [id])
  toSeller       User?       @relation("TransferToSeller", fields: [toSellerId], references: [id])
  toSalesPoint   SalesPoint? @relation("TransferToSalesPoint", fields: [toSalesPointId], references: [id])
  authorizedBy   User        @relation("TransferAuthorizedBy", fields: [authorizedById], references: [id])

  @@index([ticketId])
  @@map("ticket_transfers")
}

/// Every change of inventory / payment / admission status. Append-only.
model TicketInventoryMovement {
  id            String                   @id @default(uuid()) @db.Uuid
  ticketId      String                   @map("ticket_id") @db.Uuid
  actorId       String?                  @map("actor_id") @db.Uuid
  action        String // GENERATED | ASSIGNED | TRANSFERRED | SOLD | ACTIVATED | ISSUED_COMP | CHECKED_IN | VOIDED | RETURNED | RESTOCKED | REVERSED | REISSUED | RECONCILED
  fromInventory TicketInventoryStatus?   @map("from_inventory")
  toInventory   TicketInventoryStatus?   @map("to_inventory")
  fromPayment   PaymentCollectionStatus? @map("from_payment")
  toPayment     PaymentCollectionStatus? @map("to_payment")
  fromAdmission TicketAdmissionStatus?   @map("from_admission")
  toAdmission   TicketAdmissionStatus?   @map("to_admission")
  note          String?
  createdAt     DateTime                 @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId])
  @@map("ticket_inventory_movements")
}

// ───────────────────────────── Cash ─────────────────────────────

enum CashTransactionType {
  SALE
  REVERSAL
}

/// The payment collection ledger. Append-only (trigger). Seller balances are always
/// reconstructable as SUM(amount_millimes) per (seller, event).
model CashTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  type           CashTransactionType
  eventId        String              @map("event_id") @db.Uuid
  ticketId       String              @map("ticket_id") @db.Uuid
  sellerId       String              @map("seller_id") @db.Uuid
  salesPointId   String?             @map("sales_point_id") @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  /// Positive for SALE (official price), negative for REVERSAL.
  amountMillimes Int                 @map("amount_millimes")
  /// Who declared the cash collected (always the authenticated seller for SALE).
  reportedById   String              @map("reported_by_id") @db.Uuid
  /// Team Leader who authorized a REVERSAL.
  authorizedById String?             @map("authorized_by_id") @db.Uuid
  reversesId     String?             @unique @map("reverses_id") @db.Uuid
  reason         String?
  createdAt      DateTime            @default(now()) @map("created_at")

  event        Event                  @relation(fields: [eventId], references: [id])
  ticket       Ticket                 @relation(fields: [ticketId], references: [id])
  seller       User                   @relation("CashSeller", fields: [sellerId], references: [id])
  salesPoint   SalesPoint?            @relation(fields: [salesPointId], references: [id])
  customer     CustomerIdentityRecord @relation(fields: [customerId], references: [id])
  account      SellerCashAccount      @relation(fields: [accountId], references: [id])
  reportedBy   User                   @relation("CashReportedBy", fields: [reportedById], references: [id])
  authorizedBy User?                  @relation("CashAuthorizedBy", fields: [authorizedById], references: [id])
  reverses     CashTransaction?       @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy   CashTransaction?       @relation("Reversal")

  @@index([sellerId, eventId])
  @@map("cash_transactions")
}

/// One per (seller, event). Cached totals are updated in the same transaction as the
/// ledger and can be verified with reconstructAccount().
model SellerCashAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  sellerId           String   @map("seller_id") @db.Uuid
  eventId            String   @map("event_id") @db.Uuid
  /// Σ cash reported collected − Σ authorized reversals
  expectedMillimes   Int      @default(0) @map("expected_millimes")
  /// Σ cash physically received & confirmed by a Team Leader
  reconciledMillimes Int      @default(0) @map("reconciled_millimes")
  createdAt          DateTime @default(now()) @map("created_at")

  seller          User                 @relation(fields: [sellerId], references: [id])
  event           Event                @relation(fields: [eventId], references: [id])
  transactions    CashTransaction[]
  handovers       CashHandover[]
  reconciliations CashReconciliation[]
  discrepancies   CashDiscrepancy[]

  @@unique([sellerId, eventId])
  @@map("seller_cash_accounts")
}

enum HandoverStatus {
  SUBMITTED // seller declared an amount; liability NOT reduced
  RECEIVED // Team Leader counted and reconciled
  CANCELLED
}

model CashHandover {
  id               String         @id @default(uuid()) @db.Uuid
  accountId        String         @map("account_id") @db.Uuid
  sellerId         String         @map("seller_id") @db.Uuid
  declaredMillimes Int            @map("declared_millimes")
  note             String?
  status           HandoverStatus @default(SUBMITTED)
  createdAt        DateTime       @default(now()) @map("created_at")

  account        SellerCashAccount   @relation(fields: [accountId], references: [id])
  seller         User                @relation("HandoverSeller", fields: [sellerId], references: [id])
  reconciliation CashReconciliation?

  @@map("cash_handovers")
}

enum ReconciliationOutcome {
  BALANCED
  DISCREPANCY
}

/// A Team Leader physically counted cash from a seller. Append-only.
/// CHECK: reconciled_by_id <> seller_id (no self-reconciliation).
model CashReconciliation {
  id                        String                @id @default(uuid()) @db.Uuid
  accountId                 String                @map("account_id") @db.Uuid
  sellerId                  String                @map("seller_id") @db.Uuid
  handoverId                String?               @unique @map("handover_id") @db.Uuid
  reconciledById            String                @map("reconciled_by_id") @db.Uuid
  countedMillimes           Int                   @map("counted_millimes")
  declaredMillimes          Int?                  @map("declared_millimes")
  expectedBeforeMillimes    Int                   @map("expected_before_millimes")
  outstandingBeforeMillimes Int                   @map("outstanding_before_millimes")
  isFinal                   Boolean               @default(false) @map("is_final")
  outcome                   ReconciliationOutcome
  note                      String?
  createdAt                 DateTime              @default(now()) @map("created_at")

  account       SellerCashAccount @relation(fields: [accountId], references: [id])
  handover      CashHandover?     @relation(fields: [handoverId], references: [id])
  reconciledBy  User              @relation("ReconciledBy", fields: [reconciledById], references: [id])
  discrepancies CashDiscrepancy[]

  @@map("cash_reconciliations")
}

enum DiscrepancyStatus {
  OPEN
  EXPLANATION_REQUIRED
  EXPLAINED
  RESOLVED
}

model CashDiscrepancy {
  id               String            @id @default(uuid()) @db.Uuid
  accountId        String            @map("account_id") @db.Uuid
  reconciliationId String            @map("reconciliation_id") @db.Uuid
  /// Positive = cash missing (seller owes more), negative = surplus.
  amountMillimes   Int               @map("amount_millimes")
  kind             String // DECLARED_VS_COUNTED | FINAL_OUTSTANDING
  status           DiscrepancyStatus @default(OPEN)
  explanation      String?
  explainedAt      DateTime?         @map("explained_at")
  resolvedById     String?           @map("resolved_by_id") @db.Uuid
  resolutionNote   String?           @map("resolution_note")
  resolvedAt       DateTime?         @map("resolved_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  account        SellerCashAccount  @relation(fields: [accountId], references: [id])
  reconciliation CashReconciliation @relation(fields: [reconciliationId], references: [id])
  resolvedBy     User?              @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id])

  @@map("cash_discrepancies")
}

// ───────────────────────────── Reservations (separate inventory) ─────────────────────────────

enum ReservationExpiryPolicy {
  HOURS_AFTER_CREATION
  AT_RESERVATION_CLOSE
  AT_EVENT_START
}

/// Separate reservation quota. NEVER touches paid inventory counters.
model ReservationInventory {
  id                        String                  @id @default(uuid()) @db.Uuid
  eventId                   String                  @unique @map("event_id") @db.Uuid
  enabled                   Boolean                 @default(false)
  /// Quota of reserved attendee places across PENDING reservations.
  maxReservedAttendees      Int                     @map("max_reserved_attendees")
  maxTicketsPerReservation  Int                     @map("max_tickets_per_reservation")
  opensAt                   DateTime                @map("opens_at")
  closesAt                  DateTime                @map("closes_at")
  expiryPolicy              ReservationExpiryPolicy @map("expiry_policy")
  expiryHours               Int?                    @map("expiry_hours")
  /// Whether unpaid reservations may ever be admitted (only if real capacity remains).
  allowReservationAdmission Boolean                 @default(false) @map("allow_reservation_admission")
  /// Atomic counter of attendee places held by PENDING reservations.
  pendingAttendees          Int                     @default(0) @map("pending_attendees")

  event Event @relation(fields: [eventId], references: [id])

  @@map("reservation_inventory")
}

enum ReservationStatus {
  PENDING
  EXPIRED
  CANCELLED
  CONVERTED
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  eventId     String            @map("event_id") @db.Uuid
  categoryId  String            @map("category_id") @db.Uuid
  /// Opaque lookup code given to the customer.
  code        String            @unique
  purchaserId String            @map("purchaser_id") @db.Uuid
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime          @map("expires_at")
  handledById String?           @map("handled_by_id") @db.Uuid
  closedAt    DateTime?         @map("closed_at")
  closeReason String?           @map("close_reason")
  createdAt   DateTime          @default(now()) @map("created_at")

  event     Event                  @relation(fields: [eventId], references: [id])
  category  TicketCategory         @relation(fields: [categoryId], references: [id])
  purchaser CustomerIdentityRecord @relation(fields: [purchaserId], references: [id])
  handledBy User?                  @relation("ReservationHandledBy", fields: [handledById], references: [id])
  attendees ReservationAttendee[]

  @@index([eventId, status])
  @@map("reservations")
}

model ReservationAttendee {
  id            String    @id @default(uuid()) @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  identityId    String    @map("identity_id") @db.Uuid
  /// Unpaid reservation-based admission (does NOT create a paid ticket).
  admittedAt    DateTime? @map("admitted_at")
  admittedById  String?   @map("admitted_by_id") @db.Uuid

  reservation Reservation            @relation(fields: [reservationId], references: [id])
  identity    CustomerIdentityRecord @relation(fields: [identityId], references: [id])
  admittedBy  User?                  @relation("ReservationAdmittedBy", fields: [admittedById], references: [id])
  ticket      Ticket?

  @@unique([reservationId, identityId])
  @@index([eventId, identityId])
  @@map("reservation_attendees")
}

// ───────────────────────────── Audit & scanning ─────────────────────────────

/// Append-only (trigger). Never contains plaintext CIN.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ScanLog {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  ticketId  String?  @map("ticket_id") @db.Uuid
  scannerId String   @map("scanner_id") @db.Uuid
  /// ADMITTED | DUPLICATE | UNSOLD | REVOKED | WRONG_EVENT | UNKNOWN | VENUE_FULL
  result    String
  createdAt DateTime @default(now()) @map("created_at")

  event   Event?  @relation(fields: [eventId], references: [id])
  ticket  Ticket? @relation(fields: [ticketId], references: [id])
  scanner User    @relation(fields: [scannerId], references: [id])

  @@index([eventId, result])
  @@map("scan_logs")
}

model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  html      String
  sentAt    DateTime? @map("sent_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("email_outbox")
}
